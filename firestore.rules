rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Hardened Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function staffRecord() {
      return get(/databases/$(database)/documents/support_staff_permissions/$(request.auth.uid)).data;
    }

    function isStaff() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/support_staff_permissions/$(request.auth.uid))
        && staffRecord().active == true;
    }

    function isStaffOrAdmin() {
      return isAdmin() || isStaff();
    }

    function isValidTicketCategory(cat) {
      return cat in [
        'Technical Support',
        'Payment & Billing',
        'Minecraft Server Support',
        'Account Issues',
        'Bug Report',
        'Other'
      ];
    }

    function isValidTicketPriority(p) {
      return p in ['low', 'normal', 'high', 'urgent'];
    }

    function isValidTicketStatus(s) {
      return s in ['open', 'in_progress', 'waiting_for_user', 'answered', 'resolved', 'closed'];
    }

    function isValidStoreSectionId(sectionId) {
      return sectionId in [
        'subAdminKeys',
        'items',
        'categories',
        'leaderboard',
        'staffList',
        'couponsList',
        'activityLogs',
        'updatesList',
        'voteLinks',
        'tickets',
        'config',
        'saleConfig',
        'connectionGuide',
        'rulesCategories',
        'orders'
      ];
    }

    function isValidStoreSection(sectionId, data) {
      return data.keys().hasAll(['key', 'value', 'updatedAt'])
        && data.keys().hasOnly(['key', 'value', 'updatedAt'])
        && data.key is string
        && data.key.size() <= 64
        && data.key == sectionId
        && data.updatedAt is int
        && data.updatedAt > 0;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'role', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'updatedAt'])
        && data.uid is string
        && data.uid.size() > 0
        && data.uid.size() <= 128
        && data.uid == userId
        && data.email is string
        && data.email.size() <= 254
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.role is string
        && data.role == 'player'
        && data.updatedAt == request.time;
    }

    function isValidSupportTicketCreate(data, ticketId) {
      return data.keys().hasAll([
          'id', 'ticketNumber', 'userId', 'username', 'userEmail',
          'category', 'priority', 'subject', 'description', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ticketNumber', 'userId', 'username', 'userEmail', 'ign',
          'category', 'priority', 'subject', 'description', 'status',
          'assignedStaffId', 'assignedStaffName', 'createdAt', 'updatedAt',
          'lastReplyAt', 'lastReplyByRole', 'unreadByUser', 'unreadByStaff', 'ratingSubmitted'
        ])
        && data.id == ticketId
        && data.ticketNumber is string && data.ticketNumber.size() >= 4 && data.ticketNumber.size() <= 32
        && data.userId == request.auth.uid
        && data.username is string && data.username.size() > 0 && data.username.size() <= 80
        && data.userEmail is string && data.userEmail.size() > 0 && data.userEmail.size() <= 254
        && isValidTicketCategory(data.category)
        && isValidTicketPriority(data.priority)
        && data.subject is string && data.subject.size() >= 3 && data.subject.size() <= 160
        && data.description is string && data.description.size() >= 5 && data.description.size() <= 5000
        && data.status == 'open'
        && (!('assignedStaffId' in data) || data.assignedStaffId == '')
        && (!('assignedStaffName' in data) || data.assignedStaffName == '')
        && (!('ratingSubmitted' in data) || data.ratingSubmitted == false);
    }

    function isValidSupportMessageCreate(data, messageId) {
      return data.keys().hasAll([
          'id', 'ticketId', 'ticketOwnerId', 'senderId', 'senderName',
          'senderRole', 'message', 'isInternal', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'ticketId', 'ticketOwnerId', 'senderId', 'senderName',
          'senderRole', 'senderStaffTitle', 'message', 'isInternal', 'attachmentIds', 'createdAt'
        ])
        && data.id == messageId
        && isValidId(data.ticketId)
        && data.message is string && data.message.size() > 0 && data.message.size() <= 4000
        && data.isInternal is bool
        && data.senderId == request.auth.uid
        && data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 80
        && exists(/databases/$(database)/documents/support_tickets/$(data.ticketId));
    }

    // 3. Boot Connection Health Check (read-only)
    match /test/connection {
      allow get: if request.time != null;
      allow list, write: if false;
    }

    // 4. Admins & Support Staff Permission Registry
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && isValidId(adminId)
        && incoming().keys().hasAll(['uid', 'email', 'role'])
        && incoming().keys().hasOnly(['uid', 'email', 'name', 'role', 'createdAt'])
        && incoming().uid == adminId
        && incoming().email is string && incoming().email.size() <= 254
        && incoming().role in ['admin', 'owner'];
      allow delete: if isAdmin();
    }

    match /support_staff_permissions/{staffId} {
      allow get: if isSignedIn() && (request.auth.uid == staffId || isStaffOrAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && isValidId(staffId)
        && incoming().keys().hasAll(['id', 'name', 'roleTitle', 'active', 'canReply'])
        && incoming().keys().hasOnly([
          'id', 'name', 'roleTitle', 'email', 'active',
          'canViewAllTickets', 'canReply', 'canAssign', 'canChangeStatus',
          'canAddInternalNotes', 'canDeleteTickets', 'updatedAt'
        ])
        && incoming().id == staffId
        && incoming().active is bool
        && incoming().canReply is bool;
      allow delete: if isAdmin();
    }

    // 5. Customer Profiles (PII strictly owner-scoped, no listing)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId);
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().role == existing().role
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'updatedAt']);
      allow delete: if false;
    }

    // 6. Support Tickets Collection
    match /support_tickets/{ticketId} {
      allow get, list: if isVerifiedUser() && isValidId(ticketId) && (
        existing().userId == request.auth.uid ||
        isAdmin() ||
        (isStaff() && (staffRecord().canViewAllTickets == true || existing().assignedStaffId == request.auth.uid))
      );
      allow create: if isVerifiedUser() && isValidId(ticketId) && isValidSupportTicketCreate(incoming(), ticketId);
      allow update: if isVerifiedUser() && isValidId(ticketId) && (
        (
          isAdmin()
          && incoming().id == existing().id
          && incoming().ticketNumber == existing().ticketNumber
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && isValidTicketCategory(incoming().category)
          && isValidTicketPriority(incoming().priority)
          && isValidTicketStatus(incoming().status)
        ) || (
          isStaff()
          && (staffRecord().canViewAllTickets == true || existing().assignedStaffId == request.auth.uid)
          && incoming().id == existing().id
          && incoming().ticketNumber == existing().ticketNumber
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && isValidTicketCategory(incoming().category)
          && isValidTicketPriority(incoming().priority)
          && isValidTicketStatus(incoming().status)
          && (incoming().status == existing().status || staffRecord().canChangeStatus == true)
          && (!incoming().diff(existing()).affectedKeys().hasAny(['assignedStaffId', 'assignedStaffName']) || staffRecord().canAssign == true)
        ) || (
          existing().userId == request.auth.uid
          && incoming().userId == existing().userId
          && incoming().status == existing().status
          && incoming().priority == existing().priority
          && (!incoming().diff(existing()).affectedKeys().hasAny(['lastReplyByRole']) || incoming().lastReplyByRole == 'user')
          && incoming().diff(existing()).affectedKeys().hasOnly(['unreadByUser', 'unreadByStaff', 'lastReplyAt', 'lastReplyByRole', 'updatedAt', 'ratingSubmitted'])
        )
      );
      allow delete: if isAdmin() || (isStaff() && staffRecord().canDeleteTickets == true);
    }

    // 7. Support Conversation Messages & Private Internal Staff Notes
    match /support_messages/{messageId} {
      allow get, list: if isVerifiedUser() && isValidId(messageId) && (
        isAdmin() ||
        isStaff() ||
        (existing().ticketOwnerId == request.auth.uid && existing().isInternal == false)
      );
      allow create: if isVerifiedUser() && isValidId(messageId) && isValidSupportMessageCreate(incoming(), messageId) && (
        (
          isAdmin()
          && incoming().senderRole in ['staff', 'admin', 'system']
        ) || (
          isStaff()
          && staffRecord().canReply == true
          && incoming().senderRole == 'staff'
          && (!incoming().isInternal || staffRecord().canAddInternalNotes == true)
        ) || (
          incoming().senderRole == 'user'
          && incoming().isInternal == false
          && (!('senderStaffTitle' in incoming()) || incoming().senderStaffTitle == '')
          && incoming().ticketOwnerId == request.auth.uid
          && get(/databases/$(database)/documents/support_tickets/$(incoming().ticketId)).data.userId == request.auth.uid
        )
      );
      allow update, delete: if false;
    }

    // 8. Support Attachments
    match /support_attachments/{attachmentId} {
      allow get, list: if isVerifiedUser() && isValidId(attachmentId) && (
        isStaffOrAdmin() || existing().ticketOwnerId == request.auth.uid
      );
      allow create: if isVerifiedUser() && isValidId(attachmentId)
        && incoming().keys().hasAll(['id', 'ticketId', 'ticketOwnerId', 'uploaderId', 'fileName', 'mimeType', 'sizeBytes', 'dataUrl', 'createdAt'])
        && incoming().keys().hasOnly(['id', 'ticketId', 'ticketOwnerId', 'messageId', 'uploaderId', 'fileName', 'mimeType', 'sizeBytes', 'dataUrl', 'createdAt'])
        && incoming().id == attachmentId
        && incoming().uploaderId == request.auth.uid
        && incoming().sizeBytes is int && incoming().sizeBytes > 0 && incoming().sizeBytes <= 5242880
        && exists(/databases/$(database)/documents/support_tickets/$(incoming().ticketId))
        && (
          isStaffOrAdmin() ||
          (
            incoming().ticketOwnerId == request.auth.uid &&
            get(/databases/$(database)/documents/support_tickets/$(incoming().ticketId)).data.userId == request.auth.uid
          )
        );
      allow update: if false;
      allow delete: if isAdmin();
    }

    // 9. Support Staff Assignments
    match /support_staff_assignments/{assignmentId} {
      allow get, list: if isStaffOrAdmin();
      allow create, update: if isAdmin() || (isStaff() && staffRecord().canAssign == true);
      allow delete: if isAdmin();
    }

    // 10. Support Notifications
    match /support_notifications/{notificationId} {
      allow get, list: if isVerifiedUser() && isValidId(notificationId) && (
        (existing().recipientType == 'user' && existing().recipientId == request.auth.uid) ||
        (existing().recipientType in ['staff', 'admin'] && isStaffOrAdmin())
      );
      allow create: if isVerifiedUser() && isValidId(notificationId)
        && incoming().keys().hasAll(['id', 'recipientType', 'recipientId', 'ticketId', 'ticketNumber', 'type', 'title', 'body', 'read', 'createdAt'])
        && incoming().keys().hasOnly(['id', 'recipientType', 'recipientId', 'ticketId', 'ticketNumber', 'type', 'title', 'body', 'read', 'createdAt'])
        && incoming().id == notificationId
        && incoming().read == false
        && (
          isStaffOrAdmin() ||
          incoming().recipientType in ['staff', 'admin']
        );
      allow update: if isVerifiedUser() && isValidId(notificationId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['read'])
        && incoming().read == true
        && (
          (existing().recipientType == 'user' && existing().recipientId == request.auth.uid) ||
          (existing().recipientType in ['staff', 'admin'] && isStaffOrAdmin())
        );
      allow delete: if isAdmin();
    }

    // 11. Support Ticket Ratings (1 rating per resolved ticket; doc id == ticketId)
    match /support_ratings/{ratingId} {
      allow get, list: if isVerifiedUser() && isValidId(ratingId) && (
        isStaffOrAdmin() || existing().userId == request.auth.uid
      );
      allow create: if isVerifiedUser() && isValidId(ratingId)
        && incoming().keys().hasAll(['id', 'ticketId', 'ticketNumber', 'userId', 'username', 'stars', 'createdAt'])
        && incoming().keys().hasOnly(['id', 'ticketId', 'ticketNumber', 'userId', 'username', 'stars', 'feedback', 'createdAt'])
        && incoming().id == ratingId
        && incoming().ticketId == ratingId
        && incoming().userId == request.auth.uid
        && incoming().stars is int && incoming().stars >= 1 && incoming().stars <= 5
        && (!('feedback' in incoming()) || (incoming().feedback is string && incoming().feedback.size() <= 1000))
        && exists(/databases/$(database)/documents/support_tickets/$(ratingId))
        && get(/databases/$(database)/documents/support_tickets/$(ratingId)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/support_tickets/$(ratingId)).data.status == 'resolved';
      allow update, delete: if false;
    }

    function isValidWalletTransactionType(t) {
      return t in [
        'wallet_recharge',
        'product_purchase',
        'refund',
        'admin_credit',
        'admin_debit',
        'promotional_credit'
      ];
    }

    function isValidPaymentType(pt) {
      return pt in ['wallet_recharge', 'direct_product', 'wallet_product', 'combined', 'refund'];
    }

    function isValidPaymentStatus(ps) {
      return ps in ['pending', 'processing', 'successful', 'failed', 'cancelled', 'refunded', 'partially_refunded'];
    }

    function isValidUserWallet(data, userId) {
      return data.keys().hasAll([
          'userId', 'balance', 'totalCreditsAdded', 'totalCreditsSpent',
          'totalRefunds', 'totalPromotionalCredits', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'username', 'email', 'balance', 'totalCreditsAdded',
          'totalCreditsSpent', 'totalRefunds', 'totalPromotionalCredits',
          'createdAt', 'updatedAt'
        ])
        && data.userId == userId
        && data.balance is number && data.balance >= 0
        && data.totalCreditsAdded is number && data.totalCreditsAdded >= 0
        && data.totalCreditsSpent is number && data.totalCreditsSpent >= 0
        && data.totalRefunds is number && data.totalRefunds >= 0
        && data.totalPromotionalCredits is number && data.totalPromotionalCredits >= 0
        && (!('username' in data) || (data.username is string && data.username.size() <= 80))
        && (!('email' in data) || (data.email is string && data.email.size() <= 254));
    }

    function isValidWalletTransaction(data, txId) {
      return data.keys().hasAll([
          'id', 'transactionRef', 'userId', 'type', 'amount',
          'previousBalance', 'updatedBalance', 'description', 'status', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'transactionRef', 'userId', 'type', 'amount',
          'previousBalance', 'updatedBalance', 'description',
          'relatedOrderId', 'paymentId', 'status', 'adminId', 'reason', 'createdAt'
        ])
        && data.id == txId
        && data.transactionRef is string && data.transactionRef.size() > 0 && data.transactionRef.size() <= 64
        && isValidId(data.userId)
        && isValidWalletTransactionType(data.type)
        && data.amount is number && data.amount >= 0
        && data.previousBalance is number && data.previousBalance >= 0
        && data.updatedBalance is number && data.updatedBalance >= 0
        && data.description is string && data.description.size() <= 400;
    }

    function isValidPaymentRecord(data, paymentId) {
      return data.keys().hasAll([
          'id', 'transactionId', 'userId', 'amount',
          'paymentMethod', 'paymentGateway', 'paymentType', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'transactionId', 'orderId', 'userId', 'username', 'email', 'productName',
          'amount', 'walletAmount', 'onlineAmount', 'onlineTransactionId',
          'paymentMethod', 'paymentGateway', 'paymentType', 'status',
          'gatewayReference', 'createdAt', 'updatedAt'
        ])
        && data.id == paymentId
        && data.transactionId is string && data.transactionId.size() <= 128
        && isValidId(data.userId)
        && data.amount is number && data.amount >= 0
        && data.paymentMethod is string && data.paymentMethod.size() <= 40
        && data.paymentGateway is string && data.paymentGateway.size() <= 40
        && isValidPaymentType(data.paymentType)
        && isValidPaymentStatus(data.status);
    }

    // 12. User Wallets (read owner-only or admin; mutations strictly server/admin)
    match /user_wallets/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isVerifiedUser() && (isAdmin() || existing().userId == request.auth.uid);
      allow create, update: if isAdmin() && isValidId(userId) && isValidUserWallet(incoming(), userId);
      allow delete: if false;
    }

    // 13. Wallet Transactions (strictly immutable append-only ledger)
    match /wallet_transactions/{transactionId} {
      allow get: if isVerifiedUser() && isValidId(transactionId) && (isAdmin() || existing().userId == request.auth.uid);
      allow list: if isVerifiedUser() && (isAdmin() || existing().userId == request.auth.uid);
      allow create: if isAdmin() && isValidId(transactionId) && isValidWalletTransaction(incoming(), transactionId);
      allow update, delete: if false;
    }

    // 14. Wallet Recharges
    match /wallet_recharges/{rechargeId} {
      allow get: if isVerifiedUser() && isValidId(rechargeId) && (isAdmin() || existing().userId == request.auth.uid);
      allow list: if isVerifiedUser() && (isAdmin() || existing().userId == request.auth.uid);
      allow create, update: if isAdmin()
        && isValidId(rechargeId)
        && incoming().keys().hasAll(['id', 'rechargeRef', 'userId', 'amount', 'credits', 'paymentMethod', 'paymentGateway', 'status', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly([
          'id', 'rechargeRef', 'userId', 'username', 'email', 'amount', 'credits',
          'paymentMethod', 'paymentGateway', 'gatewayOrderId', 'gatewayPaymentId', 'paymentId', 'status', 'createdAt', 'updatedAt'
        ])
        && incoming().id == rechargeId
        && incoming().amount is number && incoming().amount >= 1
        && incoming().credits is number && incoming().credits >= 1;
      allow delete: if false;
    }

    // 15. Payments Registry
    match /payments/{paymentId} {
      allow get: if isVerifiedUser() && isValidId(paymentId) && (isAdmin() || existing().userId == request.auth.uid);
      allow list: if isVerifiedUser() && (isAdmin() || existing().userId == request.auth.uid);
      allow create: if isAdmin() && isValidId(paymentId) && isValidPaymentRecord(incoming(), paymentId);
      allow update: if isAdmin()
        && isValidId(paymentId)
        && isValidPaymentRecord(incoming(), paymentId)
        && existing().status != 'refunded'
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    // 16. Payment Refunds (immutable audit records)
    match /payment_refunds/{refundId} {
      allow get: if isVerifiedUser() && isValidId(refundId) && (isAdmin() || existing().userId == request.auth.uid);
      allow list: if isVerifiedUser() && (isAdmin() || existing().userId == request.auth.uid);
      allow create: if isAdmin()
        && isValidId(refundId)
        && incoming().keys().hasAll(['id', 'refundRef', 'paymentId', 'userId', 'totalRefundAmount', 'reason', 'adminId', 'status', 'createdAt'])
        && incoming().keys().hasOnly([
          'id', 'refundRef', 'paymentId', 'orderId', 'userId', 'totalRefundAmount',
          'walletRefundAmount', 'onlineRefundAmount', 'gatewayRefundId', 'walletTransactionId',
          'reason', 'adminId', 'adminName', 'status', 'createdAt'
        ])
        && incoming().id == refundId
        && incoming().totalRefundAmount is number && incoming().totalRefundAmount >= 0
        && incoming().reason is string && incoming().reason.size() <= 300;
      allow update, delete: if false;
    }

    // 17. Partitioned Storefront State Sections
    match /store_sections/{sectionId} {
      allow get: if isValidStoreSectionId(sectionId) && sectionId != 'subAdminKeys' && sectionId != 'orders' && sectionId != 'tickets';
      allow list: if existing().key is string && isValidStoreSectionId(existing().key) && existing().key != 'subAdminKeys' && existing().key != 'orders' && existing().key != 'tickets';
      allow create, update: if isAdmin() && isValidStoreSectionId(sectionId) && isValidStoreSection(sectionId, incoming());
      allow delete: if false;
    }

    // 18. Legacy Storefront Snapshot (read-only migration fallback)
    match /store/{docId} {
      allow get: if docId == 'global_state' && isAdmin();
      allow list, write: if false;
    }
  }
}
