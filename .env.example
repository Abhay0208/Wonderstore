# Firebase Web SDK configuration (public client configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIRESTORE_DATABASE_ID=

# Firebase Admin SDK (server only)
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=secrets/firebase-service-account.json

# Server-side authentication secrets (never prefix these with VITE_)
ADMIN_SECURITY_KEY=
SUPPORT_SESSION_SECRET=

# Optional: enable Firebase email/password provider in the frontend
VITE_FIREBASE_EMAIL_AUTH=false

# Backend Firestore database ID (leave empty to use the default database)
FIRESTORE_DATABASE_ID=
