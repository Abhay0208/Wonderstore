# =============================================================================
# WONDERMC — Environment Variables Template
# =============================================================================
# Copy to .env and fill in values. NEVER commit .env to Git.
# BACKEND-ONLY secrets are never exposed to the browser (no VITE_ prefix).

# ---- Supabase (required) ----
# Frontend (anon/public key only — safe for browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend (service role — TRUSTED ONLY, never expose to browser)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Application security (backend only) ----
# Owner login secret. Verified on the server with a constant-time comparison.
ADMIN_SECURITY_KEY=
# Session signing secret. MUST be strong (>=32 chars) and STABLE across
# deploys/restarts (set it in Render environment, not a local file).
SUPPORT_SESSION_SECRET=

# ---- Payment gateway (backend only) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GATEWAY_SIGNING_SECRET=
RAZORPAY_MODE=test

# ---- Integrations (backend only) ----
DISCORD_WEBHOOK_URL=
DISCORD_SUPPORT_WEBHOOK_URL=
APP_URL=

# ---- Server ----
# Render injects PORT automatically; local dev defaults to 3000.
PORT=3000
NODE_ENV=production
